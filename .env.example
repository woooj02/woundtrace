# Copy to .env (optional). Without AWS credentials the app runs the rules engine with local storage.
# USE_BEDROCK=1                         # use the Bedrock agent locally (needs AWS credentials, us-east-1)
# BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
# AGENT_ENGINE=bedrock                  # bedrock | rules
# DAILY_LLM_RUNS=150
# STALL_DAYS=28
# STALL_REDUCTION=0.5
# BUCKET=                               # S3 bucket (Lambda); DATA_DIR for local storage
